---
import { userLabel } from '../lib/firebase';
import { TOOLS } from '../lib/tools';
---

<header class="site-header" id="site-header">
  <div class="container header-inner">
    <a href="/" class="brand" aria-label="DocFlow home">
      <img src="/logo.png" alt="DocFlow" width="34" height="34" />
      <span>DocFlow</span>
    </a>

    <nav class="main-nav" aria-label="Main">
      <a href="/#tools">All tools</a>
      <a href="/#features">Features</a>
      <a href="/#pricing">Pricing</a>
    </nav>

    <div class="header-actions" id="header-actions">
      <!-- Auth state is filled in by client script (scripts/auth-header.js) -->
      <a class="btn btn-ghost auth-guest" href="/login">Log in</a>
      <a class="btn btn-primary auth-guest" href="/signup">Sign up free</a>
      <div class="account-chip auth-user" hidden>
        <button class="account-btn" id="account-btn" aria-haspopup="true" aria-expanded="false">
          <span class="avatar" id="account-avatar"></span>
          <span class="account-name" id="account-name"></span>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
        </button>
        <div class="account-menu" id="account-menu" role="menu" hidden>
          <div class="account-menu-head">
            <div class="account-menu-email" id="account-email"></div>
            <div class="quota-line" id="quota-line" hidden></div>
          </div>
          <a href="/#tools" role="menuitem">All tools</a>
          <button id="signout-btn" role="menuitem">Sign out</button>
        </div>
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 60;
    background: rgb(255 255 255 / 0.88);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--divider);
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: 28px;
    height: 68px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 20px;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .brand img {
    border-radius: 8px;
  }

  .main-nav {
    display: flex;
    gap: 26px;
    margin-left: 12px;
    font-size: 15px;
    font-weight: 500;
    color: var(--text-2);
  }

  .main-nav a:hover {
    color: var(--primary);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-left: auto;
  }

  .header-actions .btn {
    padding: 9px 20px;
    font-size: 14px;
  }

  .account-chip {
    position: relative;
  }

  .account-btn {
    display: flex;
    align-items: center;
    gap: 9px;
    background: var(--primary-tint);
    color: var(--primary-deep);
    border: 1px solid #dcdffb;
    border-radius: 999px;
    padding: 6px 14px 6px 6px;
    font-weight: 600;
    font-size: 14px;
  }

  .avatar {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--primary);
    color: #fff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
  }

  .account-menu {
    position: absolute;
    right: 0;
    top: calc(100% + 10px);
    width: 240px;
    background: #fff;
    border: 1px solid var(--divider);
    border-radius: var(--radius-tile);
    box-shadow: var(--shadow-lg);
    padding: 6px;
    z-index: 70;
  }

  .account-menu-head {
    padding: 10px 12px;
    border-bottom: 1px solid var(--divider);
    margin-bottom: 6px;
  }

  .account-menu-email {
    font-size: 13px;
    font-weight: 600;
    word-break: break-all;
  }

  .quota-line {
    font-size: 12px;
    color: var(--text-meta);
    margin-top: 3px;
  }

  .account-menu a,
  .account-menu button {
    display: block;
    width: 100%;
    text-align: left;
    padding: 9px 12px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 500;
    color: var(--text);
    background: none;
    border: none;
  }

  .account-menu a:hover,
  .account-menu button:hover {
    background: var(--surface-muted);
  }

  @media (max-width: 860px) {
    .main-nav {
      display: none;
    }
  }

  @media (max-width: 560px) {
    .auth-guest.btn-ghost {
      display: none;
    }
    .account-name {
      display: none;
    }
    .account-btn {
      padding: 4px;
    }
  }
</style>

<script>
  import { watchAuth, userLabel, logout, friendlyAuthError } from '../lib/firebase';
  import { fetchQuota } from '../lib/api';

  // Toggle guest vs signed-in header chrome and drive the account dropdown.
  const actions = document.getElementById('header-actions')!;
  const chip = actions.querySelector<HTMLElement>('.account-chip')!;
  const menu = document.getElementById('account-menu')!;
  const btn = document.getElementById('account-btn')!;
  const nameEl = document.getElementById('account-name')!;
  const avatarEl = document.getElementById('account-avatar')!;
  const emailEl = document.getElementById('account-email')!;
  const quotaEl = document.getElementById('quota-line')!;
  let open = false;

  function setMenu(next: boolean) {
    open = next;
    menu.hidden = !next;
    btn.setAttribute('aria-expanded', String(next));
  }

  btn.addEventListener('click', (e) => {
    e.stopPropagation();
    setMenu(!open);
  });

  document.addEventListener('click', () => setMenu(false));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setMenu(false);
  });

  document.getElementById('signout-btn')?.addEventListener('click', async () => {
    try {
      await logout();
      location.href = '/';
    } catch (err) {
      alert(friendlyAuthError(err));
    }
  });

  watchAuth(async (user) => {
    const guests = actions.querySelectorAll<HTMLElement>('.auth-guest');
    for (const el of guests) el.hidden = !!user;
    chip.hidden = !user;
    if (!user) return;

    nameEl.textContent = userLabel(user).split(' ')[0];
    emailEl.textContent = user.email || '';
    avatarEl.textContent = (userLabel(user)[0] || 'D').toUpperCase();

    const quota = await fetchQuota(user);
    if (quota) {
      quotaEl.hidden = false;
      quotaEl.textContent = quota.isPro
        ? 'DocFlow Pro — unlimited conversions'
        : `${quota.remaining ?? '—'} of ${quota.limit ?? '—'} free conversions left this month`;
    }
  });
</script>
