---
import { getTool } from '../lib/tools';

interface Props {
  toolId: string;
}

const tool = getTool(Astro.props.toolId);
if (!tool) throw new Error(`Unknown tool: ${Astro.props.toolId}`);

const fileWord = tool.multiFile ? 'files' : 'a file';
const chooseWord = tool.multiFile ? 'files' : 'a file';
---

<section class="converter" id="converter" data-tool-id={tool.id} data-multi={tool.multiFile ? 'true' : 'false'} data-min-files={tool.minFiles}>
  <div class="panel card">
    <!-- Dropzone -->
    <div class="dropzone" id="dropzone" tabindex="0" role="button"
      aria-label={"Select " + fileWord + " to convert"}>
      <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 13v8" /><path d="M8 17l4-4 4 4" />
        <path d="M20.39 18.39A5 5 0 0 0 18 9h-1.26A8 8 0 1 0 4 16.3" />
      </svg>
      <p class="dz-title">Drop {fileWord} here</p>
      <p class="dz-sub">or <span class="dz-browse">choose {chooseWord}</span> — {tool.accept.join(', ').toUpperCase()} · up to 50 MB</p>
      <input type="file" id="file-input" hidden multiple={tool.multiFile} accept={tool.accept.map((e) => `.${e}`).join(',')} />
    </div>

    <!-- Selected files -->
    <ul class="file-list" id="file-list" hidden></ul>

    <!-- Tool options -->
    <div class="options" id="options" hidden>
      <h3>Options</h3>
      <div class="options-grid" id="options-grid"></div>
    </div>

    <!-- Auth gate -->
    <div class="auth-gate alert alert-info" id="auth-gate" hidden>
      <strong>Sign in to convert.</strong>
      <span>Free accounts get 100 conversions every month.</span>
      <span class="gate-links">
        <a href={`/login?next=/tools/${tool.id}`}>Log in</a> ·
        <a href={`/signup?next=/tools/${tool.id}`}>Create a free account</a>
      </span>
    </div>

    <!-- Action row -->
    <div class="action-row" id="action-row" hidden>
      <button class="btn btn-primary btn-lg" id="convert-btn">Convert now</button>
      <button class="btn btn-ghost" id="reset-btn" hidden>Start over</button>
    </div>

    <!-- Progress -->
    <div class="progress-wrap" id="progress-wrap" hidden>
      <div class="progress-label" id="progress-label">Uploading…</div>
      <div class="progress-bar"><div class="progress-fill" id="progress-fill"></div></div>
      <p class="progress-hint">Large documents can take a minute — the engine is rebuilding your file.</p>
    </div>

    <!-- Result -->
    <div class="result" id="result" hidden>
      <div class="result-icon">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
      </div>
      <div class="result-text">
        <strong id="result-name">Done</strong>
        <span id="result-meta"></span>
      </div>
      <a class="btn btn-primary" id="download-btn" download>Download</a>
    </div>

    <!-- Errors / paywall -->
    <div id="error-slot"></div>
  </div>
</section>

<style>
  .converter {
    max-width: 760px;
    margin: 0 auto;
  }

  .panel {
    padding: 14px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .dropzone {
    border: 2px dashed #d5d8e8;
    border-radius: var(--radius-tile);
    padding: 44px 24px;
    text-align: center;
    color: var(--text-2);
    background: var(--surface-muted);
    transition: border-color 0.15s ease, background 0.15s ease;
    cursor: pointer;
    outline: none;
  }

  .dropzone:hover,
  .dropzone:focus-visible,
  .dropzone.dragover {
    border-color: var(--primary);
    background: var(--primary-tint);
  }

  .dz-title {
    font-size: 18px;
    font-weight: 700;
    color: var(--text);
    margin-top: 14px;
  }

  .dz-sub {
    font-size: 14px;
    color: var(--text-faint);
    margin-top: 6px;
  }

  .dz-browse {
    color: var(--primary);
    font-weight: 600;
    text-decoration: underline;
  }

  .file-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .file-row {
    display: flex;
    align-items: center;
    gap: 12px;
    border: 1px solid var(--divider);
    border-radius: var(--radius-field);
    padding: 10px 14px;
    background: #fff;
    font-size: 14px;
  }

  .file-row .file-name {
    font-weight: 600;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    flex: 1;
  }

  .file-row .file-size {
    color: var(--text-faint);
    font-size: 13px;
    white-space: nowrap;
  }

  .file-actions {
    display: flex;
    gap: 4px;
  }

  .icon-btn {
    width: 30px;
    height: 30px;
    border-radius: 8px;
    border: 1px solid var(--divider);
    background: #fff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--text-2);
  }

  .icon-btn:hover:not(:disabled) {
    border-color: var(--primary);
    color: var(--primary);
  }

  .icon-btn:disabled {
    opacity: 0.35;
    cursor: default;
  }

  .icon-btn svg {
    width: 15px;
    height: 15px;
  }

  .options h3 {
    font-size: 15px;
    margin-bottom: 14px;
  }

  .options-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    gap: 16px;
  }

  .auth-gate {
    display: flex;
    flex-direction: column;
    gap: 4px;
    align-items: flex-start;
  }

  .gate-links a {
    color: var(--primary-deep);
    font-weight: 700;
    text-decoration: underline;
  }

  .action-row {
    display: flex;
    gap: 12px;
    justify-content: center;
    padding-top: 4px;
  }

  .progress-wrap {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 10px 4px;
  }

  .progress-label {
    font-weight: 700;
    font-size: 15px;
    text-align: center;
  }

  .progress-bar {
    height: 10px;
    border-radius: 999px;
    background: var(--primary-tint);
    overflow: hidden;
  }

  .progress-fill {
    height: 100%;
    width: 0%;
    border-radius: 999px;
    background: linear-gradient(90deg, var(--primary-light), var(--primary));
    transition: width 0.25s ease;
  }

  .progress-fill.indeterminate {
    width: 40% !important;
    animation: slide 1.1s ease-in-out infinite alternate;
  }

  @keyframes slide {
    from { margin-left: 0; }
    to { margin-left: 60%; }
  }

  .progress-hint {
    font-size: 13px;
    color: var(--text-faint);
    text-align: center;
  }

  .result {
    display: flex;
    align-items: center;
    gap: 16px;
    border: 1px solid #cdeedd;
    background: #effaf5;
    border-radius: var(--radius-tile);
    padding: 18px 20px;
  }

  .result-icon {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: var(--green);
    color: #fff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .result-text {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .result-text strong {
    font-size: 15px;
    word-break: break-all;
  }

  .result-text span {
    font-size: 13px;
    color: var(--text-meta);
    margin-top: 2px;
  }

  #error-slot:empty {
    display: none;
  }

  .paywall-upgrade {
    margin-top: 10px;
  }
</style>

<script>
  import { getTool, type OptionField } from '../lib/tools';
  import { convert, ConversionError, formatBytes } from '../lib/api';
  import { watchAuth, type AuthUser } from '../lib/firebase';

  const root = document.getElementById('converter') as HTMLElement & {
    dataset: { toolId: string };
  };
  const tool = getTool(root.dataset.toolId);
  if (!tool) throw new Error('converter: unknown tool');

  const dropzone = document.getElementById('dropzone')!;
  const fileInput = document.getElementById('file-input') as HTMLInputElement;
  const fileList = document.getElementById('file-list')!;
  const optionsEl = document.getElementById('options')!;
  const optionsGrid = document.getElementById('options-grid')!;
  const authGate = document.getElementById('auth-gate')!;
  const actionRow = document.getElementById('action-row')!;
  const convertBtn = document.getElementById('convert-btn') as HTMLButtonElement;
  const resetBtn = document.getElementById('reset-btn') as HTMLButtonElement;
  const progressWrap = document.getElementById('progress-wrap')!;
  const progressLabel = document.getElementById('progress-label')!;
  const progressFill = document.getElementById('progress-fill')!;
  const resultEl = document.getElementById('result')!;
  const resultName = document.getElementById('result-name')!;
  const resultMeta = document.getElementById('result-meta')!;
  const downloadBtn = document.getElementById('download-btn') as HTMLAnchorElement;
  const errorSlot = document.getElementById('error-slot')!;

  let files: File[] = [];
  let user: AuthUser | null = null;
  let busy = false;
  let downloadUrl: string | null = null;

  /* ---------- option defaults ---------- */
  const defaults: Record<string, string> = {
    pages: 'all',
    level: 'low',
    grayscale: 'false',
    fit: 'fitDocumentToImage',
    autoRotate: 'true',
    format: 'png',
    singlePage: 'false',
    dpi: '300',
    size: '30',
    angle: '45',
    opacity: '0.5',
    color: '#d3d3d3',
  };

  /* ---------- auth ---------- */
  watchAuth((u) => {
    user = u;
    syncGate();
  });

  function syncGate() {
    const haveFiles = files.length >= tool!.minFiles;
    authGate.hidden = !(haveFiles && !user);
    actionRow.hidden = !haveFiles;
    convertBtn.hidden = !user;
  }

  /* ---------- option controls ---------- */
  function buildOptions() {
    if (tool!.options.length === 0) {
      optionsEl.hidden = true;
      return;
    }
    optionsEl.hidden = false;
    // Seed every control's default from the catalog entry itself. This takes
    // precedence over the legacy table above: option keys like "format" and
    // "angle" mean different things per tool (PNG vs PPTX, watermark 45° vs
    // rotate 90°), so a shared fallback table cannot be authoritative.
    for (const opt of tool!.options) {
      if ('default' in opt && opt.default !== undefined) {
        defaults[opt.key] = opt.default;
      }
    }
    optionsGrid.innerHTML = '';
    for (const opt of tool!.options) {
      optionsGrid.appendChild(fieldFor(opt));
    }
  }

  function fieldFor(opt: OptionField): HTMLElement {
    const wrap = document.createElement('div');
    if (opt.type === 'checkbox') {
      wrap.className = 'field check-field';
      const input = document.createElement('input');
      input.type = 'checkbox';
      input.id = `opt-${opt.key}`;
      input.checked = defaults[opt.key] === 'true';
      input.addEventListener('change', () => {
        defaults[opt.key] = input.checked ? 'true' : 'false';
      });
      const label = document.createElement('label');
      label.htmlFor = input.id;
      label.textContent = opt.label;
      wrap.append(input, label);
      if (opt.help) wrap.appendChild(helpSpan(opt.help));
      return wrap;
    }

    wrap.className = opt.type === 'color' ? 'field color-field' : 'field';
    const label = document.createElement('label');
    label.htmlFor = `opt-${opt.key}`;
    label.textContent = opt.label;
    const input = document.createElement('input');

    switch (opt.type) {
      case 'select': {
        const select = document.createElement('select');
        select.id = `opt-${opt.key}`;
        for (const c of opt.choices) {
          const o = document.createElement('option');
          o.value = c.value;
          o.textContent = c.label;
          if (defaults[opt.key] === c.value) o.selected = true;
          select.appendChild(o);
        }
        select.addEventListener('change', () => {
          defaults[opt.key] = select.value;
        });
        wrap.append(label, select);
        break;
      }
      case 'number': {
        input.type = 'number';
        input.min = String(opt.min);
        input.max = String(opt.max);
        if (opt.step) input.step = String(opt.step);
        input.value = defaults[opt.key];
        input.addEventListener('input', () => {
          defaults[opt.key] = input.value;
        });
        wrap.append(label, input);
        break;
      }
      case 'color': {
        input.type = 'color';
        input.value = defaults[opt.key];
        input.addEventListener('input', () => {
          defaults[opt.key] = input.value;
        });
        wrap.append(input, label);
        break;
      }
      default: {
        // text | password
        input.type = opt.type;
        input.id = `opt-${opt.key}`;
        if ('placeholder' in opt && opt.placeholder) input.placeholder = opt.placeholder;
        input.autocomplete = opt.type === 'password' ? 'new-password' : 'off';
        input.addEventListener('input', () => {
          defaults[opt.key] = input.value;
        });
        wrap.append(label, input);
      }
    }
    if ('help' in opt && opt.help) wrap.appendChild(helpSpan(opt.help));
    return wrap;
  }

  function helpSpan(text: string): HTMLElement {
    const s = document.createElement('span');
    s.className = 'help';
    s.textContent = text;
    return s;
  }

  function collectOptions(): Record<string, string> {
    const out: Record<string, string> = {};
    for (const opt of tool!.options) {
      const v = defaults[opt.key];
      // Selects, checkboxes and colors always carry a meaningful value;
      // free-text fields (password, watermark text, page ranges) are sent
      // only when filled so required-field validation stays meaningful.
      if (opt.type === 'checkbox' || opt.type === 'select' || opt.type === 'color') {
        out[opt.key] = v;
      } else if (v && v.trim() !== '') {
        out[opt.key] = v.trim();
      }
    }
    return out;
  }

  /* ---------- file list ---------- */
  const EXT_OK = new Set(tool.accept);

  function addFiles(incoming: FileList | File[]) {
    const rejected: string[] = [];
    for (const f of Array.from(incoming)) {
      const ext = (f.name.split('.').pop() || '').toLowerCase();
      if (!EXT_OK.has(ext)) {
        rejected.push(f.name);
        continue;
      }
      if (!tool!.multiFile) files = [f];
      else files.push(f);
    }
    if (rejected.length) {
      showError(
        `${rejected.join(', ')} — wrong file type. This tool accepts: ${tool!.accept.join(', ').toUpperCase()}.`,
      );
    } else {
      clearError();
    }
    renderFiles();
  }

  function renderFiles() {
    fileList.innerHTML = '';
    for (let i = 0; i < files.length; i++) {
      const li = document.createElement('li');
      li.className = 'file-row';

      const name = document.createElement('span');
      name.className = 'file-name';
      name.textContent = files[i].name;

      const size = document.createElement('span');
      size.className = 'file-size';
      size.textContent = formatBytes(files[i].size);

      const actions = document.createElement('span');
      actions.className = 'file-actions';

      if (tool!.multiFile) {
        const up = moveBtn('up', () => {
          [files[i - 1], files[i]] = [files[i], files[i - 1]];
          renderFiles();
        });
        up.disabled = i === 0;
        const down = moveBtn('down', () => {
          [files[i + 1], files[i]] = [files[i], files[i + 1]];
          renderFiles();
        });
        down.disabled = i === files.length - 1;
        actions.append(up, down);
      }

      const remove = document.createElement('button');
      remove.className = 'icon-btn';
      remove.type = 'button';
      remove.title = 'Remove';
      remove.innerHTML =
        '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>';
      remove.addEventListener('click', () => {
        files.splice(i, 1);
        renderFiles();
      });
      actions.appendChild(remove);

      li.append(name, size, actions);
      fileList.appendChild(li);
    }
    fileList.hidden = files.length === 0;
    syncGate();
  }

  function moveBtn(dir: 'up' | 'down', onClick: () => void): HTMLButtonElement {
    const b = document.createElement('button');
    b.className = 'icon-btn';
    b.type = 'button';
    b.title = dir === 'up' ? 'Move earlier' : 'Move later';
    b.innerHTML =
      dir === 'up'
        ? '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m18 15-6-6-6 6"/></svg>'
        : '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>';
    b.addEventListener('click', onClick);
    return b;
  }

  /* ---------- drag & drop + picker ---------- */
  dropzone.addEventListener('click', () => fileInput.click());
  dropzone.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' || e.key === ' ') {
      e.preventDefault();
      fileInput.click();
    }
  });
  fileInput.addEventListener('change', () => {
    addFiles(fileInput.files ?? []);
    fileInput.value = '';
  });
  for (const ev of ['dragenter', 'dragover']) {
    dropzone.addEventListener(ev, (e) => {
      e.preventDefault();
      dropzone.classList.add('dragover');
    });
  }
  for (const ev of ['dragleave', 'drop']) {
    dropzone.addEventListener(ev, (e) => {
      e.preventDefault();
      dropzone.classList.remove('dragover');
    });
  }
  dropzone.addEventListener('drop', (e) => {
    addFiles(e.dataTransfer?.files ?? []);
  });

  /* ---------- errors ---------- */
  function showError(message: string, opts?: { paywall?: ConversionError }) {
    errorSlot.innerHTML = '';
    const div = document.createElement('div');
    div.className = 'alert alert-error';
    const strong = document.createElement('strong');
    strong.textContent = message;
    div.appendChild(strong);
    if (opts?.paywall) {
      const detail = document.createElement('div');
      detail.textContent = `You have used ${opts.paywall.used ?? 'all'} of your ${opts.paywall.limit ?? 100} free conversions this month. New conversions are added at the start of each month, or use DocFlow on mobile with Pro.`;
      div.appendChild(detail);
    }
    errorSlot.appendChild(div);
  }

  function clearError() {
    errorSlot.innerHTML = '';
  }

  /* ---------- reset ---------- */
  resetBtn.addEventListener('click', () => {
    files = [];
    renderFiles();
    resultEl.hidden = true;
    resetBtn.hidden = true;
    clearError();
    if (downloadUrl) {
      URL.revokeObjectURL(downloadUrl);
      downloadUrl = null;
    }
  });

  /* ---------- convert ---------- */
  convertBtn.addEventListener('click', async () => {
    if (busy || !user) return;
    if (files.length < tool!.minFiles) {
      showError(
        tool!.multiFile && tool!.minFiles > 1
          ? `This tool needs at least ${tool!.minFiles} files.`
          : 'Choose a file first.',
      );
      return;
    }

    // Client-side validation of required text options (mirrors backend rules).
    const opts = collectOptions();
    for (const opt of tool!.options) {
      if ('required' in opt && opt.required && !opts[opt.key]) {
        showError(`"${opt.label}" is required.`);
        return;
      }
    }
    if (tool!.id === 'protect-pdf' && (opts.password || '').length < 4) {
      showError('The password must be at least 4 characters.');
      return;
    }
    if (tool!.id === 'split-pdf' && !opts.pages) {
      showError('Enter the pages to extract, e.g. 1,3,5-9.');
      return;
    }

    busy = true;
    clearError();
    resultEl.hidden = true;
    convertBtn.disabled = true;
    progressWrap.hidden = false;
    setProgress('Uploading…', 0);

    try {
      const token = await user.getIdToken();
      const result = await convert({
        toolId: tool!.id,
        files,
        options: opts,
        token,
        onProgress: (p) => {
          if (p.phase === 'uploading') setProgress('Uploading…', p.fraction);
          else setProgress('Converting…', 1);
        },
      });

      if (downloadUrl) URL.revokeObjectURL(downloadUrl);
      downloadUrl = URL.createObjectURL(result.blob);
      downloadBtn.href = downloadUrl;
      downloadBtn.download = result.filename;
      resultName.textContent = result.filename;
      resultMeta.textContent =
        `${result.contentType.split(';')[0]} · ${formatBytes(result.blob.size)}` +
        (result.quota && !result.quota.isPro && result.quota.remaining != null
          ? ` · ${result.quota.remaining} free conversions left`
          : '');
      resultEl.hidden = false;
      resetBtn.hidden = false;
    } catch (err) {
      if (err instanceof ConversionError) {
        showError(err.message, { paywall: err.status === 402 ? err : undefined });
      } else {
        showError('Conversion failed. Please try again.');
      }
    } finally {
      busy = false;
      convertBtn.disabled = false;
      progressWrap.hidden = true;
    }
  });

  function setProgress(label: string, fraction: number) {
    progressLabel.textContent = label;
    progressFill.classList.remove('indeterminate');
    if (fraction >= 1) {
      progressFill.style.width = '100%';
      progressFill.classList.add('indeterminate');
    } else {
      progressFill.style.width = `${Math.round(fraction * 100)}%`;
    }
  }

  buildOptions();
</script>
