---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolConverter from '../../components/ToolConverter.astro';
import ToolCard from '../../components/ToolCard.astro';
import { TOOLS, getTool, ICONS } from '../../lib/tools';

export function getStaticPaths() {
  return TOOLS.map((tool) => ({ params: { id: tool.id }, props: { tool } }));
}

const { tool } = Astro.props;
const related = TOOLS.filter((t) => t.id !== tool.id && t.category === tool.category).slice(0, 3);
const relatedFinal =
  related.length > 0 ? related : TOOLS.filter((t) => t.id !== tool.id).slice(0, 3);
---

<BaseLayout title={`${tool.title} — DocFlow`} description={tool.description}>
  <section class="tool-hero">
    <div class="container">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a> <span>/</span> <a href="/#tools">Tools</a> <span>/</span>
        <span class="crumb-current">{tool.title}</span>
      </nav>
      <div class="tool-head">
        <span class="tool-icon" style={`--c:${tool.color};--t:${tool.tint}`}>
          <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICONS[tool.icon]} />
        </span>
        <div>
          <h1>{tool.title}</h1>
          <p>{tool.description}</p>
        </div>
        <span class="formats-badge">
          {tool.from}
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          {tool.to}
        </span>
      </div>
    </div>
  </section>

  <section class="section converter-section">
    <div class="container">
      <ToolConverter toolId={tool.id} />
      <p class="privacy-note">
        Files up to 50 MB · processed in memory · never stored on our servers
      </p>
    </div>
  </section>

  <section class="section section-muted">
    <div class="container how-it-works">
      <h2>How to {tool.title.toLowerCase()}</h2>
      <ol class="steps">
        {tool.steps.map((step, i) => (
          <li class="card">
            <span class="step-num">{i + 1}</span>
            <p>{step}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>Related tools</h2>
      </div>
      <div class="related-grid">
        {relatedFinal.map((t) => <ToolCard tool={t} />)}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .tool-hero {
    padding: 44px 0 8px;
    background:
      radial-gradient(700px 320px at 20% -20%, #eef0ff 0%, transparent 60%);
  }

  .crumbs {
    font-size: 14px;
    color: var(--text-faint);
    display: flex;
    gap: 8px;
    margin-bottom: 28px;
  }

  .crumbs a:hover {
    color: var(--primary);
  }

  .crumb-current {
    color: var(--text-2);
    font-weight: 600;
  }

  .tool-head {
    display: flex;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
  }

  .tool-icon {
    width: 66px;
    height: 66px;
    border-radius: 18px;
    background: var(--t);
    color: var(--c);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .tool-head h1 {
    font-size: clamp(28px, 4vw, 40px);
  }

  .tool-head p {
    margin-top: 8px;
    color: var(--text-2);
    font-size: 16px;
  }

  .formats-badge {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.05em;
    background: #fff;
    border: 1px solid var(--divider);
    border-radius: 999px;
    padding: 9px 18px;
    color: var(--text-meta);
    box-shadow: var(--shadow-sm);
  }

  .converter-section {
    padding-top: 36px;
    padding-bottom: 56px;
  }

  .privacy-note {
    text-align: center;
    font-size: 13px;
    color: var(--text-faint);
    margin-top: 20px;
  }

  .how-it-works h2 {
    text-align: center;
    font-size: clamp(24px, 3.4vw, 34px);
    margin-bottom: 40px;
  }

  .steps {
    list-style: none;
    padding: 0;
    margin: 0 auto;
    max-width: 860px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    counter-reset: step;
  }

  .steps li {
    padding: 26px 24px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .step-num {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--primary-tint);
    color: var(--primary-deep);
    font-weight: 800;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .steps p {
    font-size: 15px;
    color: var(--text-2);
    line-height: 1.6;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  @media (max-width: 820px) {
    .steps {
      grid-template-columns: 1fr;
    }
    .related-grid {
      grid-template-columns: 1fr;
      max-width: 440px;
      margin: 0 auto;
    }
    .formats-badge {
      margin-left: 0;
    }
  }
</style>
