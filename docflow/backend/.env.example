# ---------------------------------------------------------------------------
# DocFlow backend configuration
#
# Copy to .env for local development. On Azure Container Apps, set these as
# secrets/env vars instead — never bake them into the image.
# ---------------------------------------------------------------------------

# Port the server listens on. Azure Container Apps injects this; 8080 locally.
PORT=8080

# ---------------------------------------------------------------------------
# Firebase Admin SDK
#
# Preferred: base64-encode the whole service-account JSON into one variable.
# The private key contains newlines, which survive base64 but get mangled by
# most secret stores when pasted raw.
#
#   Windows PowerShell:
#     [Convert]::ToBase64String([IO.File]::ReadAllBytes("service-account.json"))
#   macOS / Linux / Git Bash:
#     base64 -w0 service-account.json
#
# Leave both blank to fall back to Application Default Credentials (useful if
# you run on a Google-managed runtime, not on Azure).
# ---------------------------------------------------------------------------
FIREBASE_SERVICE_ACCOUNT_B64=
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Optional. Inferred from the service account when omitted.
FIREBASE_PROJECT_ID=

# ---------------------------------------------------------------------------
# Stirling-PDF engine
#
# The internal URL of your Stirling-PDF container app. This must NOT be
# publicly reachable — the whole point of this backend is that it is the only
# thing allowed to talk to Stirling.
# ---------------------------------------------------------------------------
STIRLING_BASE_URL=http://localhost:8081

# Only needed if your Stirling instance has login/API keys enabled.
STIRLING_API_KEY=

# How long to wait for Stirling to finish a conversion, in milliseconds.
STIRLING_TIMEOUT_MS=120000

# ---------------------------------------------------------------------------
# Quota
# ---------------------------------------------------------------------------

# Free conversions per calendar month. Pro users are unlimited.
FREE_MONTHLY_LIMIT=100

# Largest upload accepted, in megabytes. Held in RAM, so keep this sane
# relative to the container's memory limit.
MAX_UPLOAD_MB=50

# Most files a single multi-file job (merge, image->pdf) may carry.
MAX_FILES_PER_REQUEST=20

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------

# Comma-separated origins for CORS. Mobile apps don't send Origin, so this
# only matters if you call the API from a browser. Empty = allow none.
CORS_ORIGINS=

# Requests per minute per authenticated user.
RATE_LIMIT_PER_MINUTE=30

NODE_ENV=development
