{
  "name": "docflow-backend",
  "version": "1.0.0",
  "private": true,
  "description": "DocFlow's traffic cop: verifies Firebase ID tokens, enforces the conversion quota, and proxies files to Stirling-PDF in memory.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test:engine": "node test/engine.test.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "firebase-admin": "^13.0.2",
    "helmet": "^8.0.0",
    "multer": "^2.0.0"
  }
}
