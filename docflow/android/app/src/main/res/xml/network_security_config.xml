<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow cleartext HTTP to the DocFlow Oracle backend only -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">145.241.123.187</domain>
    </domain-config>
    <!-- All other traffic (Firebase, Google, Stirling on Azure) remains HTTPS only -->
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
